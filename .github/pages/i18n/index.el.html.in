<title>Αποθετήριο APT του OpenELP DB9CR</title>
@@HREFLANG_LINKS@@
<style>
  body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
  pre { background: #f0f0f0; padding: 0.75rem 1rem; overflow-x: auto; border-radius: 4px; }
  code { background: #f0f0f0; padding: 0.1rem 0.3rem; border-radius: 3px; }
  pre code { background: none; padding: 0; }
  table { border-collapse: collapse; margin: 1rem 0; }
  th, td { border: 1px solid #ccc; padding: 0.3rem 0.6rem; text-align: left; }
  .note { color: #555; font-size: 0.95em; }
  .langs { font-size: 0.85em; line-height: 1.8; border-bottom: 1px solid #ccc; padding-bottom: 0.5rem; }
  .langs a, .langs strong { white-space: nowrap; margin-right: 0.6em; }
